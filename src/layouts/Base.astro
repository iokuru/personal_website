---
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/cards.css";
import "../styles/stats.css";
import "../styles/blogs.css";

export interface Props {
  title: string;
  description?: string;
  page?: string;
}

const { title, description = "Krishna Katiyar", page = "home" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&family=Noto+Sans+Devanagari:wght@700;800&family=Noto+Sans+Gujarati:wght@700;800&family=Noto+Sans+Gurmukhi:wght@700;800&family=Noto+Sans+JP:wght@700;800&family=Noto+Sans+KR:wght@700;800&family=Noto+Sans+Kannada:wght@700;800&family=Noto+Sans+Malayalam:wght@700;800&family=Noto+Sans+Oriya:wght@700;800&family=Noto+Sans+SC:wght@700;800&family=Noto+Sans+Tamil:wght@700;800&family=Noto+Sans+Telugu:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <script is:inline>
      (function () {
        var removeBadge = function () {
          var el = document.getElementById("nl-badge-frame") || document.getElementById("nl-hud-frame");
          if (el) el.remove();
        };
        var observer = new MutationObserver(removeBadge);
        observer.observe(document.documentElement, { childList: true, subtree: true });
        window.addEventListener("DOMContentLoaded", removeBadge);
      })();
    </script>
  </head>
  <body>
    <div class="shell" id={page}>
      <slot />
    </div>
  </body>
</html>
